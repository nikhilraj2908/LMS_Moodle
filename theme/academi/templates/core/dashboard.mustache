      margin-top:auto !important;   /* override inline margin-top */

}

.top-row .continue-button,
.top-row a.continue-button,
.top-row a.course-link-button {
  margin-top: auto;  /* pins CTA to the bottom so all cards end evenly */
}

/* Slightly reduce the big progress block spacing so it doesn't force extra height */
.top-row .progress-container {
  margin: 40px auto 40px; /* was larger in one card */
}

/* --- Responsive columns for the row --- */
@media (max-width: 1199px) {
  .top-row {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}
@media (max-width: 991px) {
  .top-row {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
@media (max-width: 767px) {
  .top-row {
    grid-template-columns: 1fr; /* stack on mobile */
    margin: 10px 15px !important;
  }
}


/* ===========================
   Equal heights for FIRST ROW only
   =========================== */
.container > .top-row:first-of-type {
  display: grid !important;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 20px;
  align-items: stretch;
}

/* Ensure each learning-card stretches fully */
.container > .top-row:first-of-type .learning-card {
  display: flex;
  flex-direction: column;
  height: 100%;
}

/* Make card content grow, button pinned to bottom */
.container > .top-row:first-of-type .card-content,
.container > .top-row:first-of-type #course-carousel,
.container > .top-row:first-of-type .recentcourse-card-inner {
  flex: 1 1 auto;
  display: flex;
  flex-direction: column;
}

.container > .top-row:first-of-type .continue-button,
.container > .top-row:first-of-type a.course-link-button {
  margin-top: auto;
}

/* Responsive column counts */
@media (max-width: 1199px) {
  .container > .top-row:first-of-type {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}
@media (max-width: 991px) {
  .container > .top-row:first-of-type {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
@media (max-width: 767px) {
  .container > .top-row:first-of-type {
    grid-template-columns: 1fr;
  }
}

/* ===========================
   Second row stays FLEX layout
   =========================== */
.container > .top-row:not(:first-of-type) {
