.continue-button,
a.course-link-button {
  /* layout */
  display: flex !important;
  align-items: center;
  justify-content: center;
  width: min(100%, 460px);       /* center on desktop, full width on small screens */
  margin-inline: auto;

  /* sizing */
  min-height: 44px;              /* accessible tap target */
  padding: clamp(10px, 1.6vw, 16px) clamp(16px, 2.4vw, 28px) !important;
  font-size: clamp(14px, 1.15vw, 18px) !important;
  line-height: 1.2;

  /* shape */
  border-radius: clamp(14px, 3vw, 30px) !important;

  /* make sure long text never overflows */
  white-space: nowrap;
  text-overflow: ellipsis;
  overflow: hidden;
}


/* Tablets (768–1199): a touch wider, comfortable padding */
@media (max-width: 1199px) and (min-width: 768px) {
  .continue-button,
  a.course-link-button {
    width: 100%;
    max-width: 520px;
  }
}

/* Mobiles (≤ 767): full width, slightly larger text for readability */
@media (max-width: 767px) {
  .continue-button,
  a.course-link-button {
    width: 100% !important;
    max-width: none;
    padding: 12px 18px !important;
    font-size: 16px !important;    /* prevents iOS zoom on focus */
    border-radius: 16px !important;
  }
}

/* Small mobiles (≤ 480): tighter padding, keep tap target */
@media (max-width: 480px) {
  .continue-button,
  a.course-link-button {
    padding: 12px 16px !important;
    font-size: 15px !important;
    border-radius: 14px !important;
  }
}



