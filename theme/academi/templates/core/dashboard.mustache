};

fetch('/moodle/theme/academi/streak.php', {
    method: 'POST',
    credentials: 'same-origin'
})
.then(response => response.json())
.then(data => {
    const streakCount = data.streakCount || 0;

    // Update circle count
    document.getElementById('streak-count').textContent = streakCount;

    // Update progress bar
    const progressBar = document.getElementById('streak-progress-bar');
    const progressPercent = Math.min((streakCount / 10) * 100, 100);
    if (progressBar) {
        progressBar.style.width = `${progressPercent}%`;
    }

    // 🌟 Moved here: control opacity + animation of badges
    const badgeThresholds = {
        bronze: 10,
        silver: 30,
        gold: 50,
        platinum: 80
    };

    Object.entries(badgeThresholds).forEach(([badge, threshold]) => {
        const previewEl = document.querySelector(`#badge-preview-${badge} img`);
        if (previewEl) {
            if (streakCount >= threshold) {
                previewEl.style.opacity = '1';
                previewEl.classList.add('earned-badge');
            } else {
                previewEl.style.opacity = '0.2';
                previewEl.classList.remove('earned-badge');
            }
        }
    });

    // Show main badge (if any)
    const badges = ['bronze', 'silver', 'gold', 'platinum'];
    badges.forEach(b => {
        const el = document.getElementById(`${b}-badge`);
        if (el) el.style.display = 'none';
    });

    if (streakCount >= 80) {
        document.getElementById('platinum-badge')?.classList.add('badge-show');
    } else if (streakCount >= 50) {
        document.getElementById('gold-badge')?.classList.add('badge-show');
    } else if (streakCount >= 30) {
        document.getElementById('silver-badge')?.classList.add('badge-show');
    } else if (streakCount >= 10) {
        document.getElementById('bronze-badge')?.classList.add('badge-show');
    }
})
.catch(console.error);





        document.addEventListener("DOMContentLoaded", function () {
            const courseItems = document.querySelectorAll("#course-carousel .course-item");
            let currentIndex = 0;
            if (courseItems.length === 0) return;

            function showCourse(index) {
                courseItems.forEach((item, i) => {
                    if (i === index) {
                        item.classList.add('show');
                        item.classList.remove('hide');
                    } else {
                        item.classList.remove('show');
                        item.classList.add('hide');
                    }
                });
            }

            function startCarousel() {
                showCourse(currentIndex);
                setInterval(() => {
                    currentIndex = (currentIndex + 1) % courseItems.length;
                    showCourse(currentIndex);
                }, 3500);
            }

            startCarousel();
        });
