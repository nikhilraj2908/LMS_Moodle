            }
            
            .course-image img {
                height: 120px;
            }
            
            .course-name {
                font-size: 18px;
            }
            
            .continue-button {
                padding: 10px 20px;
                font-size: 14px;
            }
            
            .hours-number {
                font-size: 24px;
            }
            
            .coursecount {
                font-size: 40px !important;
            }
        }
        
        /* Landscape Mobile (up to 767px and height < 500px) */
        @media (max-width: 767px) and (max-height: 500px) {
            .top-row {
                gap: 10px;
            }
            
            .learning-card {
                padding: 15px;
            }
            
            .progress-container {
                margin: 20px auto 20px !important;
            }
            
            .streak-hover-container {
                margin-top: 10px !important;
            }
